# Use a specific platform if needed
FROM node:16.20.2

WORKDIR /app

# We no longer need nodemon installed globally
# RUN npm install -g nodemon

COPY package.json ./

# Install dependencies, including pm2
RUN npm install

COPY . .

# Expose the port the app runs on
EXPOSE 3000

# Start the app with pm2 using npx to find the executable
CMD [ "npx", "pm2-runtime", "start", "ecosystem.config.js" ]


